# nginx site for arena-bridge (use when nginx already owns :80/:443 on the host, e.g. behind Cloudflare).
# nginx/install.sh replaces __HOST__ and obtains a certificate with certbot.
map $http_upgrade $connection_upgrade_ab {
    default upgrade;
    ""      close;
}
server {
    listen 80;
    listen [::]:80;
    server_name __HOST__;
    location ^~ /.well-known/acme-challenge/ { root /var/www/html; default_type "text/plain"; }
    location / { return 301 https://$host$request_uri; }
}
#SSL-BLOCK-BELOW
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __HOST__;
    ssl_certificate     /etc/letsencrypt/live/__HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__HOST__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    client_max_body_size 2g;
    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;               # WebSocket for device agents
        proxy_set_header Connection $connection_upgrade_ab;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_request_buffering off;
        proxy_buffering off;
    }
}
