# Fresh install: sudo bash deploy-vps.sh creates .env automatically.
# This file documents advanced manual configuration; if copied, replace ALL placeholders and chmod 600 .env.
BRIDGE_HOST=bridge.example.com
BRIDGE_TOKEN=replace-with-output-of-openssl-rand-hex-24
TZ=Asia/Shanghai
# REQUIRED: use a salted hash, never the plaintext UNLOCK_PASSWORD in container env.
# read -rsp 'Password: ' PW; echo; HASH=$(printf %s "$PW" | node scripts/hash-password.mjs); unset PW
# printf 'UNLOCK_PASSWORD_HASH=\x27%s\x27\n' "$HASH" >> .env
UNLOCK_PASSWORD_HASH='scrypt$REPLACE_SALT$REPLACE_HASH'
# REQUIRED for devices (generate each independently via openssl rand -hex 24).
# Entries must be distinct from BRIDGE_TOKEN; reinstall devices after migration.
DEVICE_TOKENS_JSON='{"mac":"replace-with-random-hex-48","android":"replace-with-another-random-hex-48"}'
# For an intentionally unprotected test instance ONLY; requires explicit opt-out and exposes arbitrary tools.
DISABLE_POLICY=
# Credential audit log, default /data/audit.log. Do not disable in production.
AUDIT_LOG=
# Optional registry mirrors
# NODE_BASE=docker.m.daocloud.io/library/node:22-bookworm
# CADDY_IMAGE=docker.m.daocloud.io/library/caddy:2
