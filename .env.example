# copy to .env
BRIDGE_HOST=bridge.example.com
BRIDGE_TOKEN=replace-with-output-of: openssl rand -hex 24
TZ=Asia/Shanghai
# Password the agent must obtain from you before modifying anything outside the directories in policy.json.
# Leave empty to disable the policy (everything allowed).
UNLOCK_PASSWORD=
# Opt-in GET compatibility for sandboxes whose only outbound tool is a GET fetcher (e.g. some web-AI
# platforms). OFF by default. When =1, GET /exec and GET /call become available IN ADDITION to POST;
# each GET must carry a unique rid= so a prefetched/retried GET is executed at most once. unlock/lock
# are never accepted over GET (the password must not travel in a URL). Leave unset unless you need it.
ALLOW_GET_EXEC=
# Security hardening (all optional; safe defaults shown):
# Credential-read protection is ON by default: reading .ssh/*, .env, *.pem/*.key, .aws/, .git-credentials etc.
# requires an unlock first (blocks a leaked token from exfiltrating secrets). Set =1 to turn it OFF.
SENSITIVE_READ_OPEN=
# Append a JSON line per state-changing call (exec/write/edit/delete/kill/unlock/lock) here. Default <HOME>/audit.log
# inside the container (the /data volume). Set to "off" to disable. Token/password are never written.
AUDIT_LOG=
# 国内 VPS 拉不到 Docker Hub 时打开：
# NODE_BASE=docker.m.daocloud.io/library/node:22-bookworm
# CADDY_IMAGE=docker.m.daocloud.io/library/caddy:2
